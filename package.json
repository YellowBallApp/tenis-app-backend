{
  "name": "tenis-app-backend",
  "version": "1.0.0",
  "description": "Tenis backend API",
  "main": "src/index.ts",
  "scripts": {
    "typeorm": "typeorm-ts-node-commonjs",
    "schema:drop": "npm run typeorm schema:drop -- -d src/config/data-source.ts",
    "migration:create": "npm run typeorm migration:create",
    "migration:generate": "npm run typeorm migration:generate src/migrations/InitialMigration -- -d src/config/data-source.ts",
    "migration:clean": "ts-node src/utils/helpers/indexDeleter.ts",
    "migration:new": "npm run migration:generate && npm run migration:clean",
    "migration:run": "npm run typeorm migration:run -- -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/config/data-source.ts",
    "migration:show": "npm run typeorm migration:show -- -d src/config/data-source.ts",
    "seed:create": "ts-node ./node_modules/typeorm-extension/dist/cli/index.js seed:create",
    "seed:run": "ts-node ./src/seeds/index.ts",
    "seed:reset": "npm run schema:drop && npm run seed:run",
    "restart": "rm -rf src/migrations && npm run schema:drop && npm run migration:generate && npm run migration:run && npm run seed:run && npm run dev",
    "dev": "nodemon src/index.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.856.0",
    "@aws-sdk/s3-request-presigner": "^3.856.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "chartjs-node-canvas": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "joi": "17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "nodemailer-express-handlebars": "^6.1.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.17.15",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/nodemailer-express-handlebars": "^4.0.5",
    "@types/pg": "^8.11.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
