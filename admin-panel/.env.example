# Admin Panel Environment Variables
# Bu dosyayı .env olarak kopyalayıp kendi ayarlarınızı yapın
# cp .env.example .env

# ==========================================
# KOLAY TEST İÇİN - Tek satır değiştirerek geçiş yapın!
# ==========================================

# Seçenek 1: VITE_API_MODE kullanarak (ÖNERİLEN - En kolay yöntem)
# Development/Local için:
VITE_API_MODE=development
# veya
# VITE_API_MODE=local

# Production/Server için:
# VITE_API_MODE=production
# veya
# VITE_API_MODE=server

# ==========================================
# GELİŞMİŞ SEÇENEKLER
# ==========================================

# Seçenek 2: Tam URL belirtmek için (VITE_API_MODE'dan önceliklidir)
# VITE_API_URL=http://localhost:3000/api
# veya
# VITE_API_URL=http://213.238.172.217:3000/api

# Seçenek 3: Ngrok kullanmak için
# VITE_NGROK_URL=https://abc123.ngrok-free.app

# Seçenek 4: Production IP'yi değiştirmek için
# VITE_PRODUCTION_IP=213.238.172.217
