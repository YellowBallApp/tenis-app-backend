# Backend API Configuration
# Production API URL - Gerçek telefonda kullanılacak URL
EXPO_PUBLIC_API_URL=

# Ngrok URL - Farklı ağlardan erişim için (opsiyonel)
EXPO_PUBLIC_NGROK_URL=

# Development Configuration
# Backend server port (default: 3000)
EXPO_PUBLIC_API_PORT=3000

# Android Emulator IP (default: 10.0.2.2)
EXPO_PUBLIC_EMULATOR_IP=10.0.2.2

# Weather API Configuration
# Open-Meteo API URL
EXPO_PUBLIC_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
