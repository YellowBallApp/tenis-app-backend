<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production backend server için HTTP trafiğine izin ver -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Production backend IP -->
        <domain includeSubdomains="true">213.238.172.217</domain>
    </domain-config>
    
    <!-- Development ve local network için HTTP trafiğine izin ver -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Local IP adresleri -->
        <domain includeSubdomains="true">192.168.1.115</domain>
        <domain includeSubdomains="true">192.168.1.107</domain>
        <domain includeSubdomains="true">10.209.250.139</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Local network IP aralıkları -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.2.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
    
    <!-- Diğer tüm domainler için HTTPS zorunlu -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
